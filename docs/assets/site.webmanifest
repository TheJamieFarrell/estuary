{
  "name": "Estuary — every inbox, one tide",
  "short_name": "Estuary",
  "description": "A free, open-source desktop email client for Windows. Gmail, Outlook, Spacemail and any IMAP account in one fast, offline-capable inbox.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1224",
  "theme_color": "#0b1224",
  "icons": [
    { "src": "/brand/estuary-mark.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/assets/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "/assets/favicon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icon.png", "sizes": "256x256", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
