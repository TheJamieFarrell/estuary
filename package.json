{
  "name": "estuary",
  "productName": "Estuary",
  "version": "0.2.1",
  "description": "Estuary - every inbox, one tide. Gmail, Outlook, Spacemail and any IMAP account in one desktop app.",
  "main": "./out/main/index.js",
  "author": "Jamie Farrell",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win && node scripts/write-update-manifest.mjs",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "predist": "node scripts/prepare-resources.mjs"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "electron-log": "^5.4.1",
    "iconv-lite": "^0.6.3",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.22",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "homepage": "https://estuary.email",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheJamieFarrell/estuary.git"
  },
  "bugs": {
    "url": "https://github.com/TheJamieFarrell/estuary/issues"
  }
}
